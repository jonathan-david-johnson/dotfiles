# macOS Finder metadata
.DS_Store

# Transient pi session handoffs (may reference private endpoints)
.pi/HANDOFF.md

# Per-machine pi project-trust decisions
.pi/agent/trust.json

# Karabiner auto-generated backups
.config/karabiner/automatic_backups/

# Per-machine MCP OAuth tokens and setup artifacts (secrets)
.pi/agent/mcp-auth.json
.pi/agent/cloudflare-setup-login.json
.pi/agent/mcp.json.backup-*

# Local settings and credentials stay outside version control.
.config/git/config.local
.config/zsh/.zshrc.local
.config/gh/hosts.yml
.config/usage/config.json
.config/claude/settings.json
.config/claude/settings.local.json
.config/tmux/plugins/
.config/pocket-radio/
.config/borg/
.config/op/

# herdr-app: track only user config; everything else is app-managed or runtime state
.config/herdr-app/*
!.config/herdr-app/keys.json
!.config/herdr-app/settings.json
!.config/herdr-app/layouts/
!.config/herdr-app/themes/
.config/herdr-app/layouts/.state/

# pi runtime data and setup backups (router logs contain prompts)
.pi/agent/settings.local.json
.pi/agent/mcp.local.json
.pi/agent/models-store.json
.pi/agent/pi-crash.log
.pi/agent/model-router/
.pi/agent/mcp.json.bak-*
.config/aerospace/.pi/
